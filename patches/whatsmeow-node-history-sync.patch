--- a/cmd/whatsmeow-node/events.go	2026-05-22 19:50:54.786639080 +0530
+++ b/cmd/whatsmeow-node/events.go	2026-05-22 19:50:46.960348524 +0530
@@ -164,9 +164,87 @@
 
 	// ── History Sync ─────────────────────────────
 	case *events.HistorySync:
-		sendEvent("history_sync", map[string]interface{}{
-			"type": v.Data.GetSyncType().String(),
-		})
+		data := map[string]interface{}{
+			"type":     v.Data.GetSyncType().String(),
+			"progress": v.Data.GetProgress(),
+		}
+
+		a.mu.Lock()
+		client := a.client
+		a.mu.Unlock()
+
+		if client != nil {
+			var messages []map[string]interface{}
+			var jidAliases []map[string]interface{}
+			parseFailures := 0
+			conversations := v.Data.GetConversations()
+			allConversationsComplete := len(conversations) > 0
+
+			for _, conv := range conversations {
+				if !conv.GetEndOfHistoryTransfer() {
+					allConversationsComplete = false
+				}
+
+				if oldJID := conv.GetOldJID(); oldJID != "" {
+					if newJID := conv.GetNewJID(); newJID != "" {
+						jidAliases = append(jidAliases, map[string]interface{}{
+							"oldJid": oldJID,
+							"newJid": newJID,
+						})
+					}
+				}
+
+				chatJID, err := types.ParseJID(conv.GetID())
+				if err != nil || chatJID.IsEmpty() {
+					if newJID := conv.GetNewJID(); newJID != "" {
+						chatJID, err = types.ParseJID(newJID)
+					}
+					if err != nil || chatJID.IsEmpty() {
+						continue
+					}
+				}
+				for _, histMsg := range conv.GetMessages() {
+					webMsg := histMsg.GetMessage()
+					if webMsg == nil {
+						continue
+					}
+					evt, err := client.ParseWebMessage(chatJID, webMsg)
+					if err != nil {
+						parseFailures++
+						continue
+					}
+					messages = append(messages, map[string]interface{}{
+						"info":    serializeMessageInfo(evt.Info),
+						"message": protoToMap(evt.Message),
+					})
+				}
+			}
+			if len(messages) > 0 {
+				data["messages"] = messages
+			}
+			if len(jidAliases) > 0 {
+				data["jidAliases"] = jidAliases
+			}
+			if parseFailures > 0 {
+				data["parseFailures"] = parseFailures
+			}
+			if v.Data.GetProgress() >= 100 || allConversationsComplete {
+				data["historyComplete"] = true
+			}
+
+			if len(v.Data.GetPushnames()) > 0 {
+				pushNames := make([]map[string]interface{}, 0, len(v.Data.GetPushnames()))
+				for _, pn := range v.Data.GetPushnames() {
+					pushNames = append(pushNames, map[string]interface{}{
+						"jid":      pn.GetID(),
+						"pushName": pn.GetPushname(),
+					})
+				}
+				data["pushNames"] = pushNames
+			}
+		}
+
+		sendEvent("history_sync", data)
 	}
 }
 
