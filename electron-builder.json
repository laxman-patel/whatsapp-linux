{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.laxman.whatszapp",
  "productName": "WhatsZapp",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] }
    ],
    "extraResources": [
      {
        "from": "bin/whatsmeow-node",
        "to": "whatsmeow-bin/whatsmeow-node"
      }
    ],
    "category": "Network",
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
    "desktop": {
      "Name": "WhatsZapp",
      "Comment": "AI-native WhatsApp desktop for Linux and Windows",
      "Categories": "Network;InstantMessaging;"
    }
  },
  "mac": {
    "artifactName": "${productName}-${version}-mac.${ext}",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "extraResources": [
      {
        "from": "node_modules/@whatsmeow-node/win32-x64/bin/whatsmeow-node.exe",
        "to": "whatsmeow-bin/whatsmeow-node.exe"
      }
    ],
    "artifactName": "${productName}-${version}-windows-setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
